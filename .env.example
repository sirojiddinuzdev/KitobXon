# KitobXon muhit o'zgaruvchilari
# Bu faylni .env nomi bilan nusxa oling va qiymatlarni to'ldiring:
#   cp .env.example .env

# ---------------------------------------------------------------
# MAJBURIY: production uchun o'zgartiring
# ---------------------------------------------------------------

# python -c "import secrets, string; chars = string.ascii_letters+string.digits+'!@#%^&*(-_=+)'; print(''.join(secrets.choice(chars) for _ in range(64)))"
SECRET_KEY=CHANGE_ME_generate_with_command_above

# Production: False | Development: True
DEBUG=False

# ---------------------------------------------------------------
# Ma'lumotlar bazasi (PostgreSQL)
# ---------------------------------------------------------------
POSTGRES_DB=kitobxon
POSTGRES_USER=kitobxon_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------
# Email (Gmail SMTP)
# ---------------------------------------------------------------
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here

# ---------------------------------------------------------------
# Xavfsizlik (production'da True bo'lishi shart)
# ---------------------------------------------------------------
SECURE_SSL_REDIRECT=True

# ---------------------------------------------------------------
# Celery / Redis
# ---------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0

# ---------------------------------------------------------------
# Qo'shimcha CSRF origins (vergul bilan ajrating)
# ---------------------------------------------------------------
# CSRF_TRUSTED_ORIGINS=https://yourdomain.uz,https://www.yourdomain.uz
